# Loads the demo baseline (the demo host account and the quizzes in ~/data/seed)
# into the demo's database, then exits: installed next to demo.container as
# topbanana-seed.container, with the same image and settings. Run it only while
# topbanana.service is stopped (deploy.sh on an empty ~/data/topbanana,
# demo-reset.yml every night):
#   systemctl --user start topbanana-seed.service
# It has no [Install]: nothing starts it at boot.
[Unit]
Description=Top Banana! (demo): load the demo baseline

[Container]
Image=@IMAGE@
Exec=-seed-demo
EnvironmentFile=%h/.config/topbanana/topbanana.env
Environment=APP_ENV=production
Environment=DEMO_MODE_ENABLED=true
Environment="DB_URI=file:/home/nonroot/data/topbanana.sqlite?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=synchronous(NORMAL)&_pragma=busy_timeout(5000)&_txlock=immediate"
Environment=MEDIA_DIR=/home/nonroot/data/media
Environment=BASE_URL=https://demo.topbanana.app
Environment=DEMO_SEED_ARCHIVE_DIR=/seed
Network=none
UserNS=keep-id:uid=65532,gid=65532
Volume=%h/data/topbanana:/home/nonroot/data:Z
Volume=%h/data/seed:/seed:ro,Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
# systemctl start waits until it has exited, and fails when it does.
Type=oneshot
TimeoutStartSec=300
